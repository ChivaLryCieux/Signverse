      propertyPath: bodyText
      value: "\u3010\u7B2C112\u65E5\u3011\n\u9B54\u672F\u5E08\uFF1A\u201C\u8FD9\u91CC\u5DF2\u7ECF\u53EF\u4EE5\u6E90\u6E90\u4E0D\u65AD\uFF0C\u597D\uFF0C\u5982\u679C\u8FD8\u6709\u4E0D\u8DB3\u81EA\u7136\u53EF\u4EE5\u6765\u8865\u3002\u201D\n\u9B54\u672F\u5E08\uFF1A\u201C\u4F60\u4EEC\u60F3\u8981\u7684\u3010\u95E8\u7981\u3011\uFF0C\u6211\u5DF2\u7ECF\u505A\u597D\u4E86\u3002\u5173\u4E8E\u6807\u8BC6\u2026\u2026\u6211\u4EEC\u5E94\u8BE5\u5C3D\u65E9\u5F00\u59CB\u533B\u7528\u7684\u7814\u7A76\uFF0C\u5173\u4E8E\u6750\u6599\u7684\u54C1\u8D28\u95EE\u9898\u2026\u2026\u4F9D\u7136\u8FD8\u662F\u4ECE\u5E73\u9762\u7B26\u53F7\u5165\u624B\u2026\u2026\u522B\u5FD8\u4E86\u611A\u8005\u662F\u4E3A\u4EC0\u4E48\u79BB\u5F00\u7684\uFF0C\u5173\u4E8E\u751F\u7269\u2026\u2026\u201D\n\u5BA1\u5224\uFF1A\u201C\u53EA\u8981\u662F\u4E3A\u4E86\u6700\u7EC8\u76EE\u6807\u7684\u5B9E\u73B0\uFF0C\u6211\u4EEC\u4F1A\u627E\u5230\u529E\u6CD5\u7684\u3002\u201D\n\u6559\u7687\uFF1A\u201C\u6211\u4EEC\u9700\u8981\u4E0D\u65AD\u63D0\u9AD8\u81EA\u8EAB\u7684\u4E0A\u9650\u2026\u2026\u5F53\u524D\u7684\u3010\u6784\u9650\u63D0\u53D6\u3011\u6CA1\u4E86\u611A\u8005\uFF0C\u8FDB\u5EA6\u592A\u6162\u4E86\uFF0C\u9B54\u672F\u5E08\u2026\u2026\u4F60\u660E\u767D\u2026\u2026\u201D\n\u5BA1\u5224\uFF1A\u201C\u53EA\u9760\u63D0\u5347\u6570\u91CF\u7684\u4E0A\u9650\u662F\u4E0D\u591F\u7684\uFF0C\u8FD9\u4E2A\u7F50\u5B50\u4E0D\u662F\u957F\u4E45\u4E4B\u8BA1\u3002\u201D"
