      propertyPath: bodyText
      value: "\u3010\u7B2C2\u65E5\u3011\n\u5012\u540A\u4EBA\uFF1A\u6211\u2026\u2026\u6211\u8FD8\u662F\u4E0D\u6562\u76F8\u4FE1\u2026\u2026\u8FD9\u5C45\u7136\u771F\u7684\u80FD\u8FDB\u6765\uFF01\n\u9B54\u672F\u5E08\uFF1A\u5475\u5475\u2026\u2026\u5C31\u50CF\u4E00\u5F20\u7A7A\u767D\u7684\u753B\u5E03\uFF0C\u9700\u8981\u4F60\u8DB3\u591F\u7684\u7B14\u529B\u3002\n\u5BA1\u5224\uFF1A\u522B\u50BB\u4E86\uFF0C\u6211\u7684\u670B\u53CB\uFF01\u8FD9\u5C31\u662F\u6211\u8BF4\u7684\u771F\u6B63\u7684\u6253\u7834\u5929\u82B1\u677F\u7684\u4E1C\u897F\uFF0C\u4E16\u754C\u5C31\u662F\u8FD9\u6837\u6784\u6210\u7684\uFF0C\u73B0\u5728\u6211\u4EEC\u90FD\u662F\u9020\u7269\u4E3B\uFF0C\u6CA1\u6709\u54B1\u4EEC\u7EC4\u7EC7\u7684\u6807\u8BC6\uFF0C\u6CA1\u4EBA\u80FD\u8FDB\u6765\u8FD9\u91CC\uFF01\n\u6559\u7687\uFF1A\u80FD\u6E90\u7684\u95EE\u9898\uFF0C\u4F60\u89E3\u51B3\u4E86\uFF1F\n\u5BA1\u5224\uFF1A\u6015\u4EC0\u4E48\uFF01\u8FD9\u91CC\u9762\u4EC0\u4E48\u6837\u7684\u5B9E\u9A8C\u4E0D\u80FD\u505A\uFF1F\u6211\u5C31\u8BF4\uFF0C\u8FC7\u51E0\u5929\u628A\u5B9E\u9A8C\u5BA4\u642C\u5230\u8FD9\u91CC\u9762\u6765\uFF0C\u6211\u8981\u5728\u8FD9\u5EFA\u4E00\u4E2A\u53D1\u7535\u5382\u3002\u4F60\u77E5\u9053\u5728\u8FD9\u91CC\u9762\u6709\u591A\u5927\u7684\u751F\u4EA7\u529B\uFF01\n\u5012\u540A\u4EBA\uFF1A\u8981\u662F\u611A\u8005\u8FD8\u5728\u7684\u8BDD\uFF0C\u4ED6\u4E5F\u4F1A\u6B23\u6170\u7684\u5427\u2026\u2026\u6216\u8005\uFF1F\u2026\u2026"
